---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Icon } from "astro-icon/components";
import placeholder1 from "@/assets/placeholder1.png";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((project) => !project.data.draft)
    .map((project) => ({
      params: { slug: project.id },
      props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const heroImage = project.data.images?.[0] ?? placeholder1;
---

<BaseLayout title={project.data.title} description={project.data.description} image={heroImage} imageAlt={project.data.imageAlt}>
  <section class="px-4 py-16 md:px-8 md:py-20">
    <div class="mx-auto w-full max-w-5xl">
      <div class="mb-4">
        <a href="/#projects">
          <Badge>
            <span class="flex flex-row items-center gap-2">
              <Icon name="arrow-left" class="size-4" />
              BACK TO PROJECTS
            </span>
          </Badge>
        </a>
      </div>

      <div class="overflow-hidden rounded-lg border border-border/80 bg-background-1 p-3">
        <div class="aspect-og overflow-hidden rounded-md bg-background-2">
          <Image src={heroImage} alt={project.data.imageAlt || project.data.title} class="h-full w-full object-cover" />
        </div>
      </div>

      <div class="py-8 md:py-10">
        <p class="font-mono text-xs tracking-widest text-accent-1 uppercase">Case study</p>
        <h1 class="mt-4 font-display text-5xl leading-none font-semibold tracking-tighter text-foreground-0 md:text-7xl">
          {project.data.title}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-relaxed text-foreground-1">{project.data.description}</p>

        <div class="mt-7 flex flex-wrap gap-2">
          {project.data.technologies.map((technology: string) => <Badge variant="outline">{technology}</Badge>)}
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          {
            project.data.website && (
              <a href={project.data.website} target="_blank" rel="noopener noreferrer" class={buttonVariants({ size: "lg" })}>
                Live Site
                <Icon name="arrow-up-right" class="size-4" />
              </a>
            )
          }
          {
            project.data.sourceRepo && (
              <a
                href={project.data.sourceRepo}
                target="_blank"
                rel="noopener noreferrer"
                class={buttonVariants({ variant: "outline", size: "lg" })}
              >
                Source
                <Icon name="arrow-up-right" class="size-4" />
              </a>
            )
          }
        </div>
      </div>

      <article class="prose border-t border-border/80 pt-8">
        <Content />
      </article>
    </div>
  </section>
</BaseLayout>
