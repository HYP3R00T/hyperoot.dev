---
import { Image } from "astro:assets"
import { type CollectionEntry, getCollection, render } from "astro:content"
import ArrowLeft from "@lucide/astro/icons/arrow-left"
import ProjectActivity from "@/components/project/ProjectActivity.astro"
import ProjectLinks from "@/components/project/ProjectLinks.astro"
import ProjectRevision from "@/components/project/ProjectRevision.astro"
import ProjectStats from "@/components/project/ProjectStats.astro"
import ProjectTechnologies from "@/components/project/ProjectTechnologies.astro"
import BaseLayout from "@/layouts/BaseLayout.astro"

interface Props {
  project: CollectionEntry<"projects">
}
export async function getStaticPaths() {
  return (await getCollection("projects"))
    .filter((project) => !project.data.draft && project.data.hasPage)
    .map((project) => ({ params: { slug: project.id }, props: { project } }))
}
const { project } = Astro.props
const { Content, headings } = await render(project)
const contents = headings.filter((heading) => heading.depth === 2)
const heroImage = project.data.images?.[0]
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={heroImage}
  imageAlt={project.data.imageAlt}
>
  <div class="catalog-width project-story">
    <a href="/#projects" class="text-link story-back" data-project-back
      ><ArrowLeft size={15} aria-hidden="true" /><span>Back to the collection</span></a
    >
    <header class="story-header">
      <p class="eyebrow">Project notes / {project.data.domains.join(" + ") || "The collection"}</p>
      <h1>{project.data.title}<span class="heading-period">.</span></h1>
      <p class="story-description">{project.data.description}</p>
      <div class="story-meta">
        <div class="project-updates"><ProjectActivity project={project} /><ProjectRevision project={project} /></div>
        <ProjectLinks project={project} />
      </div>
      <ProjectStats project={project} />
      <ProjectTechnologies technologies={project.data.technologies} />
    </header>
    {heroImage && (
      <Image
        class="story-image"
        src={heroImage}
        alt={project.data.imageAlt ?? `${project.data.title} preview`}
        widths={[640, 960, 1280]}
        sizes="(max-width: 768px) 100vw, 1100px"
      />
    )}
    <div class:list={["story-grid", { "story-grid-with-toc": contents.length > 0 }]}>
      <article class="prose story-content"><Content /></article>
      {contents.length > 0 && (
        <aside class="story-toc">
          <nav aria-label="On this page">
            <p class="eyebrow">On this page</p>
            <ol>
              {contents.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>
    <a href="/#projects" class="text-link story-back story-back-bottom" data-project-back
      ><ArrowLeft size={15} aria-hidden="true" /><span>Explore more projects</span></a
    >
  </div>
</BaseLayout>

<script>
function setupProjectBackLinks() {
  try {
    const stored = sessionStorage.getItem("projectArchiveReturnUrl")
    if (!stored) return
    const url = new URL(stored)
    if (url.origin !== location.origin || url.pathname !== "/" || url.hash !== "#projects") return
    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-project-back]")) link.href = url.toString()
  } catch {
    /* Keep the default collection link if storage is unavailable. */
  }
}
setupProjectBackLinks()
document.addEventListener("astro:page-load", setupProjectBackLinks)
</script>
