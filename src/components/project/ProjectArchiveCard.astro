---
import Globe from "@lucide/astro/icons/globe";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

interface Props {
  project: CollectionEntry<"projects">;
  image: ImageMetadata;
}

const { project, image } = Astro.props as Props;
const href = `/${project.id}/`;
const hasPage = project.data.hasPage;
const domains = project.data.domains.map((domain) => domain.toLowerCase()).join("|");
const imageAlt = project.data.imageAlt ?? `${project.data.title} project preview`;
const imageClasses = "project-card-image block h-full w-full object-cover";
const actionClasses = "inline-flex size-9 items-center justify-center rounded-md border border-border bg-background-1 text-foreground-2 transition-colors hover:border-accent-1 hover:bg-accent-1 hover:text-accent-contrast focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
const caseStudyClasses = "group/case-study inline-flex h-9 items-center gap-2 rounded-md bg-accent-1 px-3 font-mono text-[0.625rem] tracking-[0.1em] text-accent-contrast uppercase transition-colors hover:bg-accent-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring";
---

<article
  data-project-archive-card
  data-project-domains={domains}
  data-featured-candidate={project.data.featured ? "true" : "false"}
  class:list={[
    "project-archive-card group/card flex h-full min-w-0 flex-col overflow-hidden rounded-lg border border-border bg-background-0",
    project.data.featured && "is-featured",
  ]}
>
  <div class="aspect-video overflow-hidden bg-background-2 leading-none">
    {
      hasPage ? (
        <a href={href} data-project-case-study-link class="block h-full" aria-label={`Read the ${project.data.title} case study`}>
          <Image src={image} alt={imageAlt} class={imageClasses} widths={[480, 720, 960]} sizes="(max-width: 767px) calc(100vw - 4.5rem), (max-width: 1199px) calc(50vw - 5rem), 25rem" />
        </a>
      ) : (
        <Image src={image} alt={imageAlt} class={imageClasses} widths={[480, 720, 960]} sizes="(max-width: 767px) calc(100vw - 4.5rem), (max-width: 1199px) calc(50vw - 5rem), 25rem" />
      )
    }
  </div>

  <div class="flex min-w-0 flex-1 flex-col p-5">
    <h3 class="line-clamp-2 font-display text-[1.375rem] leading-tight font-medium tracking-[-0.02em] text-foreground-0">
      {
        hasPage ? (
          <a href={href} data-project-case-study-link class="transition-colors hover:text-accent-1">
            {project.data.title}
          </a>
        ) : (
          project.data.title
        )
      }
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-6 text-foreground-2">{project.data.description}</p>

    <div class="mt-auto flex items-center justify-between gap-4 pt-5">
      <div class="flex min-w-0 items-center gap-2" aria-label={`${project.data.title} external links`}>
        {
          project.data.sourceRepo && (
            <a href={project.data.sourceRepo} target="_blank" rel="noopener noreferrer" class={actionClasses} aria-label={`View ${project.data.title} on GitHub`} title="View GitHub repository">
              <Icon name="github" class="size-4" aria-hidden="true" />
            </a>
          )
        }
        {
          project.data.website && (
            <a href={project.data.website} target="_blank" rel="noopener noreferrer" class={actionClasses} aria-label={`Open ${project.data.title} documentation or website`} title="Open documentation or website">
              <Globe class="size-4" aria-hidden="true" />
            </a>
          )
        }
      </div>

      {
        hasPage && (
          <a href={href} data-project-case-study-link class={caseStudyClasses} aria-label={`Read the ${project.data.title} case study`}>
            <span>Case study</span>
            <Icon name="arrow-right" class="size-4 transition-transform group-hover/case-study:translate-x-0.5 motion-reduce:transition-none" aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
</article>

<style is:global>
  .project-archive-card .project-card-image {
    transform: scale(1);
    transform-origin: center;
    transition: transform 400ms cubic-bezier(0.2, 0, 0, 1);
  }

  .project-archive-card:hover .project-card-image {
    transform: scale(1.025);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-archive-card .project-card-image,
    .project-archive-card:hover .project-card-image {
      transform: scale(1);
      transition: none;
    }
  }
</style>
