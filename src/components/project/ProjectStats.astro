---
import type { CollectionEntry } from "astro:content"
import ProjectStatsContent, { type ProjectStat } from "./ProjectStatsContent"

interface Props {
  project: CollectionEntry<"projects">
}
const { project } = Astro.props
const github = project.data.private ? undefined : project.data.github
const facts = github
  ? [
      {
        kind: "stars" as const,
        label: "stars",
        singular: "star",
        value: github.stars,
        url: `${github.url}/stargazers`,
      },
      { kind: "forks" as const, label: "forks", singular: "fork", value: github.forks, url: `${github.url}/forks` },
      {
        kind: "issues" as const,
        label: "open issues",
        singular: "open issue",
        value: github.issues,
        url: `${github.url}/issues`,
      },
      {
        kind: "pullRequests" as const,
        label: "open pull requests",
        singular: "open pull request",
        value: github.pullRequests,
        url: `${github.url}/pulls`,
      },
    ]
  : []
const stats: ProjectStat[] = facts.flatMap((stat) => (stat.value === undefined ? [] : [{ ...stat, value: stat.value }]))
---

{stats.length > 0 && <ProjectStatsContent client:load title={project.data.title} stats={stats} />}
