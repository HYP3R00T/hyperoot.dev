---
import type { CollectionEntry } from "astro:content"
import { projectUpdatedAt } from "@/lib/project-catalog"
import ProjectActivity from "./ProjectActivity.astro"
import ProjectLinks from "./ProjectLinks.astro"
import ProjectRevision from "./ProjectRevision.astro"
import ProjectStats from "./ProjectStats.astro"
import ProjectTechnologies from "./ProjectTechnologies.astro"

interface Props {
  project: CollectionEntry<"projects">
  index: number
}
const { project, index } = Astro.props
const { title, description, repo, technologies, domains, github, sourceRepo } = project.data
const updatedAt = projectUpdatedAt(project.data)
const search = [
  title,
  description,
  repo,
  ...technologies,
  ...domains,
  ...(github?.topics ?? []),
  github?.language ?? "",
]
  .join(" ")
  .toLowerCase()
---

<li
  class="project-row"
  data-project-row
  data-search={search}
  data-domains={JSON.stringify(domains)}
  data-title={title}
  data-pushed={updatedAt ? Date.parse(updatedAt) : 0}
  data-stars={github?.stars ?? -1}
  data-activity={project.data.active ? "active" : "other"}
>
  <span class="project-number" data-project-number aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  <article class="project-row-content" aria-labelledby={`project-${project.id}`}>
    <div class="project-topline">
      <div class="project-row-heading">
        <h3 id={`project-${project.id}`}>
          {sourceRepo ? (
            <a
              class="project-primary-link"
              href={sourceRepo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${title} source on GitHub (opens in a new tab)`}
            >
              {title}
            </a>
          ) : (
            title
          )}
        </h3>
        <div class="project-repo-stats">
          <ProjectActivity project={project} />
        </div>
      </div>
      <ProjectStats project={project} />
    </div>
    {description && <p class="project-description">{description}</p>}
    {technologies.length > 0 && (
      <div class="project-stack">
        <ProjectTechnologies technologies={technologies} label={`${title} tags`} limit={5} />
      </div>
    )}
    <div class="project-row-footer">
      <ProjectRevision project={project} />
      <ProjectLinks project={project} includePage />
    </div>
  </article>
</li>
