---
import type { CollectionEntry } from "astro:content"
import GitCommitHorizontal from "@lucide/astro/icons/git-commit-horizontal"
import { projectUpdatedAt } from "@/lib/project-catalog"
import ProjectCommitCount from "./ProjectCommitCount"
import ProjectRevisionTooltip from "./ProjectRevisionTooltip"

interface Props {
  project: CollectionEntry<"projects">
}
const { project } = Astro.props
const { github, commit: authoredCommit } = project.data
const commit = github?.latestCommit ?? authoredCommit
const date = projectUpdatedAt(project.data)
const commitUrl = github?.latestCommit?.url
const commitCount = project.data.private ? undefined : github?.commitCount
const branch = github?.defaultBranch
const formatted = date
  ? new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(
      new Date(date),
    )
  : null
const precise = date
  ? new Intl.DateTimeFormat("en", { dateStyle: "full", timeStyle: "long", timeZone: "UTC" }).format(new Date(date))
  : null
---

{(date || commit || commitCount !== undefined) && (
  <div class="project-revision">
    {date && (
      <span>
        Updated{" "}
        <time datetime={date} title={precise ?? undefined}>
          {formatted}
        </time>
      </span>
    )}
    {commit && (
      <span class="revision-code">
        <GitCommitHorizontal size={14} aria-hidden="true" />
        <ProjectRevisionTooltip
          client:visible
          label={commit.sha.slice(0, 7)}
          url={commitUrl}
          tooltip={`${github?.latestCommit ? "Latest default-branch commit" : "Commit"}: ${commit.sha}`}
          ariaLabel={`Commit ${commit.sha.slice(0, 7)} for ${project.data.title}${commitUrl ? " (opens in a new tab)" : ""}`}
        />
      </span>
    )}
    {commitCount !== undefined && branch && github && (
      <ProjectCommitCount
        client:visible
        count={commitCount}
        branch={branch}
        url={`${github.url}/commits/${encodeURIComponent(branch)}`}
        title={project.data.title}
      />
    )}
  </div>
)}
