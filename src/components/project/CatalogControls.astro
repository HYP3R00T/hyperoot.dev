---
import Search from "@lucide/astro/icons/search"
import CatalogDropdown from "./CatalogDropdown"

interface Props {
  domains: string[]
  count: number
}
const { domains, count } = Astro.props
const activityOptions = [
  { value: "all", label: "All activity" },
  { value: "active", label: "Active in the last 30 days" },
]
const sortOptions = [
  { value: "recent", label: "Recently pushed" },
  { value: "stars", label: "Most stars" },
  { value: "name", label: "Name A–Z" },
]
---

<div class="catalog-controls" data-catalog-controls hidden>
  <div class="catalog-toolbar">
    <label class="catalog-search">
      <Search size={18} aria-hidden="true" />
      <span class="sr-only">Search projects</span>
      <input
        type="search"
        name="q"
        placeholder="Find a project, tool, or technology…"
        autocomplete="off"
        data-catalog-search
        aria-controls="project-list"
      >
      <kbd aria-hidden="true">/</kbd>
    </label>
    <div class="catalog-select">
      <span class="control-caption">Activity</span>
      <select
        id="catalog-activity"
        class="dropdown-native"
        aria-label="Filter by activity"
        data-catalog-activity
        aria-controls="project-list"
      >
        <option value="all">All activity</option>
        <option value="active">Active in the last 30 days</option>
      </select>
      <CatalogDropdown client:load controlId="catalog-activity" label="Filter by activity" options={activityOptions} />
    </div>
    <div class="catalog-select">
      <span class="control-caption">Sort</span>
      <select
        id="catalog-sort"
        class="dropdown-native"
        aria-label="Sort projects"
        data-catalog-sort
        aria-controls="project-list"
      >
        <option value="recent">Recently pushed</option>
        <option value="stars">Most stars</option>
        <option value="name">Name A–Z</option>
      </select>
      <CatalogDropdown client:load controlId="catalog-sort" label="Sort projects" options={sortOptions} />
    </div>
  </div>
  <div class="catalog-filter-bar">
    <fieldset class="catalog-domains" aria-label="Filter by domain">
      <button type="button" class="domain-filter" data-domain="all" aria-pressed="true">
        All projects <span>{count}</span>
      </button>
      {domains.map((domain) => (
        <button type="button" class="domain-filter" data-domain={domain.toLowerCase()} aria-pressed="false">
          {domain}
        </button>
      ))}
    </fieldset>
  </div>
</div>
