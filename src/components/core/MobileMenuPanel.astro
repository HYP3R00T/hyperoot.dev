---
import { Icon } from 'astro-icon/components'
import type { NavItem } from '@/lib/types'
import { buttonVariants } from '@/components/ui/button'
import { ModeToggle } from '@/components/core/ModeToggle'

interface Props {
  navItems: NavItem[]
  personalLink?: NavItem
}

const { navItems, personalLink } = Astro.props as Props
---

<div
  id='mobile-menu'
  data-mobile-menu
  data-open='false'
  class='pointer-events-none fixed top-20 right-4 left-4 z-40 mx-auto w-auto max-w-site max-h-0 -translate-y-2 overflow-hidden rounded-b-lg border-x border-b border-border bg-background-0/95 opacity-0 backdrop-blur-xl transition-all duration-300 ease-out data-[open=true]:pointer-events-auto data-[open=true]:max-h-[calc(100svh-7rem)] data-[open=true]:translate-y-0 data-[open=true]:overflow-y-auto data-[open=true]:opacity-100 md:hidden'
  role='dialog'
  aria-hidden='true'
>
  <div class='p-4 sm:p-5'>
    <nav class='grid gap-5'>
      {
        navItems.map((item) =>
          item.children?.length ? (
            <section>
              <a
                href={item.href}
                class='flex items-center justify-between py-2 font-display text-lg text-foreground-1 transition-colors hover:text-accent-1'
              >
                {item.label}
                <Icon name='arrow-right' class='size-4' />
              </a>
              <div class='mt-2 grid gap-1'>
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    target={child.blank ? '_blank' : undefined}
                    rel={child.blank ? 'noopener noreferrer' : undefined}
                    class='flex items-center justify-between gap-3 rounded-md px-3 py-3 transition-colors hover:bg-background-1'
                  >
                    <span class='font-display text-base leading-tight text-foreground-0'>{child.label}</span>
                    {child.blank && <Icon name='arrow-up-right' class='size-4 text-foreground-3' />}
                  </a>
                ))}
              </div>
            </section>
          ) : (
            <a
              href={item.href}
              target={item.blank ? '_blank' : undefined}
              rel={item.blank ? 'noopener noreferrer' : undefined}
              class='flex items-center justify-between py-2 font-display text-lg text-foreground-1 transition-colors hover:text-accent-1'
            >
              {item.label}
              {item.blank && <Icon name='arrow-up-right' class='size-4' />}
            </a>
          ),
        )
      }
    </nav>

    <div class='mt-6 flex items-center justify-end gap-2'>
      {personalLink && (
        <a
          href={personalLink.href}
          target='_blank'
          rel='noopener noreferrer'
          aria-label='Open personal website'
          title='Personal website'
          class={buttonVariants({ variant: 'outline', size: 'icon' })}
        >
          <Icon name='user' class='size-4' />
        </a>
      )}
      <ModeToggle client:load />
    </div>
  </div>
</div>
