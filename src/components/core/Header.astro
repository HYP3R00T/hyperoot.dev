---
import FolderOpen from "@lucide/astro/icons/folder-open"
import ThemeToggle from "@/components/core/ThemeToggle.astro"
import BrandMark from "./BrandMark.astro"

const isHome = Astro.url.pathname === "/"
---

<header class="lab-header" data-header-shell>
  <div class="catalog-width lab-header-inner">
    <a class="lab-brand" href="/" aria-label="Hyperoot home" title="Hyperoot home"><BrandMark /></a>
    <nav class="header-path" aria-label="Breadcrumb">
      <span aria-hidden="true">/</span><a href="/#projects"><FolderOpen size={14} aria-hidden="true" />Projects</a>
      {!isHome && (
        <>
          <span aria-hidden="true">/</span>
          <span>Reading</span>
        </>
      )}
    </nav>
    <div class="header-tools">
      <ThemeToggle />
    </div>
  </div>
</header>
