---
import FolderOpen from "@lucide/astro/icons/folder-open"
import ThemeToggle from "@/components/core/ThemeToggle.astro"
import BrandMark from "./BrandMark.astro"

const isHome = Astro.url.pathname === "/"
---

<header class="lab-header" data-header-shell>
  <div class="catalog-width lab-header-inner">
    <a class="lab-brand" href="/" aria-label="Hyperoot home" title="Hyperoot home"><BrandMark /></a>
    <nav class="header-path" aria-label="Breadcrumb">
      <span aria-hidden="true">/</span><a href="/#projects"><FolderOpen size={14} aria-hidden="true" />Projects</a>
      {!isHome && (
        <>
          <span aria-hidden="true">/</span>
          <span>Reading</span>
        </>
      )}
    </nav>
    <div class="header-tools">
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
function setupHeaderScroll() {
  const header = document.querySelector<HTMLElement>("[data-header-shell]")
  if (!header) return
  let frame = 0
  const update = () => {
    frame = 0
    header.dataset.scrolled = String(window.scrollY > 0)
  }
  const onScroll = () => {
    if (!frame) frame = requestAnimationFrame(update)
  }
  update()
  window.addEventListener("scroll", onScroll, { passive: true })
  document.addEventListener(
    "astro:before-swap",
    () => {
      window.removeEventListener("scroll", onScroll)
      cancelAnimationFrame(frame)
    },
    { once: true },
  )
}
document.addEventListener("astro:page-load", setupHeaderScroll)
</script>
