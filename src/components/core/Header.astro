---
// Header Component - Navigation and branding
import { Icon } from 'astro-icon/components'
import { navItems } from '@data/config'
import { buttonVariants } from '@/components/ui/button'
import { ModeToggle } from '@/components/core/ModeToggle'
import AnimatedText from '@/components/common/AnimatedText.tsx'
import MobileMenuToggle from '@/components/core/MobileMenuToggle.astro'
import MobileMenuPanel from '@/components/core/MobileMenuPanel.astro'
import HeaderNavigation from '@/components/core/HeaderNavigation'

const headerNavItems = navItems.filter((item) => !item.special)
const personalLink = navItems.find((item) => item.special && item.label.toLowerCase() === 'personal')
---

<header data-header-shell data-menu-open='false' class='sticky top-0 z-80 px-4 py-4 md:px-8 md:py-5'>
  <nav
    data-header-nav
    data-menu-open='false'
    class='mx-auto w-full max-w-site rounded-lg border border-border bg-background-1/90 px-4 py-3 backdrop-blur-xl transition-[border-radius] data-[menu-open=true]:rounded-b-none md:px-6'
  >
    <div class='flex items-center gap-4'>
      <a href='/' class='flex flex-1 flex-row font-mono text-base md:text-lg'>
        <AnimatedText client:load text='hyperoot' className='text-accent-1' auto={true} hover={true} />
        <div class='text-foreground-3'>.dev</div>
      </a>

      <div class='hidden flex-1 items-center justify-center gap-2 md:flex'>
        <HeaderNavigation client:load navItems={headerNavItems} />
      </div>

      <div class='hidden flex-1 items-center justify-end gap-2 md:flex text-foreground-2'>
        {
          personalLink && (
            <a
              href={personalLink.href}
              target='_blank'
              rel='noopener noreferrer'
              aria-label='Open personal website'
              title='Personal website'
              class={buttonVariants({ variant: 'ghost', size: 'icon' })}
            >
              <Icon name='user' class='size-4' />
            </a>
          )
        }
        <ModeToggle client:load />
      </div>

      <MobileMenuToggle />
    </div>
  </nav>
</header>

<MobileMenuPanel navItems={headerNavItems} personalLink={personalLink} />
