---
import SiteSection from "@/components/core/SiteSection.astro";
---

<SiteSection id="hero" data-home-section aria-labelledby="homepage-title">
  <div class="flex min-w-0 items-center px-5 py-16 md:px-10 md:py-24 lg:min-h-[36rem] lg:px-15 lg:py-28">
    <div class="max-w-4xl">
      <p class="flex items-center gap-2.5 font-mono text-[0.6875rem] tracking-[0.14em] text-foreground-1 uppercase">
        <span aria-hidden="true" class="size-1.5 rounded-full bg-accent-1"></span>
        Independent software and systems lab
      </p>

      <h1
        id="homepage-title"
        class="mt-8 max-w-3xl text-balance font-display text-[clamp(3rem,6vw,5.5rem)] leading-[0.96] font-medium tracking-[-0.04em] text-foreground-0"
      >
        Practical tools for real technical work.
      </h1>

      <p class="mt-8 max-w-2xl text-base leading-7 text-foreground-2 md:text-lg md:leading-8">
        Hyperoot Labs is a focused catalog of developer tools, automation, infrastructure systems, templates, and technical experiments built to be useful, inspectable, and reusable.
      </p>

    </div>
  </div>
</SiteSection>
