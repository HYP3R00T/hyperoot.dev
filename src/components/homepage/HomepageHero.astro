---
import { getCollection } from "astro:content"
import BrandMark from "@/components/core/BrandMark.astro"
import ProfileSocials from "./ProfileSocials.astro"

const projects = (await getCollection("projects")).filter((project) => !project.data.draft)
const activeCount = projects.filter((project) => project.data.active).length
---

<section class="catalog-hero" aria-labelledby="homepage-title">
  <div class="profile-monogram" aria-hidden="true"><BrandMark /></div>
  <div class="profile-copy">
    <p class="eyebrow">Rajesh Das / independent developer</p>
    <h1 id="homepage-title">Projects by Hyperoot.</h1>
    <p>
      A curated directory of tools, software, and infrastructure I build. Explore a project, visit its website, or read
      the source.
    </p>
  </div>
  <div class="profile-inventory">
    <span><strong>{projects.length}</strong> projects</span
    ><span><i class="activity-dot" aria-hidden="true"></i><strong>{activeCount}</strong> active this month</span>
  </div>
  <ProfileSocials />
</section>
