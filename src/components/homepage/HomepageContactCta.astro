---
import { Icon } from "astro-icon/components";
import SiteSection from "@/components/core/SiteSection.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
---

<SiteSection id="contact-cta" data-home-section aria-labelledby="contact-cta-title">
  <div class="grid gap-10 px-5 py-12 md:px-10 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(22rem,0.65fr)] lg:items-end lg:gap-20 lg:px-15 lg:py-20">
    <div>
      <p class="font-mono text-[0.6875rem] tracking-[0.14em] text-accent-1 uppercase">Have something to build?</p>
      <h2
        id="contact-cta-title"
        class="mt-5 max-w-3xl text-balance font-display text-4xl leading-[1.04] font-medium tracking-[-0.035em] text-foreground-0 md:text-5xl"
      >
        Bring a useful technical idea to life.
      </h2>
    </div>

    <div class="lg:justify-self-end">
      <p class="max-w-lg text-base leading-7 text-foreground-2">
        Hyperoot is built by Rajesh Das. Get in touch to discuss developer tooling, automation, infrastructure workflows, or a focused technical collaboration.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href="https://rajeshdas.dev/contact"
          class={cn(
            buttonVariants({ variant: "default", size: "lg" }),
            "w-fit bg-accent-1 px-5 text-background-0 hover:bg-accent-2",
          )}
        >
          Start a conversation
          <Icon name="arrow-right" class="size-4" />
        </a>
        <a
          href="https://github.com/HYP3R00T"
          target="_blank"
          rel="noopener noreferrer"
          class={cn(buttonVariants({ variant: "outline", size: "lg" }), "w-fit px-5")}
        >
          Explore GitHub
          <Icon name="arrow-up-right" class="size-4" />
        </a>
      </div>
    </div>
  </div>
</SiteSection>
