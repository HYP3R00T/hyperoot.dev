---
import { getCollection } from "astro:content";
import SectionHeader from "@/components/core/SectionHeader.astro";
import SiteSection from "@/components/core/SiteSection.astro";
import ProjectArchiveCard from "@/components/project/ProjectArchiveCard.astro";
import { ProjectDomainFilter } from "@/components/homepage/ProjectDomainFilter";
import placeholder from "@/assets/placeholder.png";
const projects = await getCollection("projects").then((entries) =>
  entries
    .filter((entry) => !entry.data.draft)
    .sort((a, b) => {
      const featuredDelta = Number(b.data.featured) - Number(a.data.featured);
      return featuredDelta || (a.data.order ?? 999) - (b.data.order ?? 999);
    }),
);
const domainCounts = new Map<string, number>();

for (const project of projects) {
  for (const domain of project.data.domains) {
    domainCounts.set(domain, (domainCounts.get(domain) ?? 0) + 1);
  }
}

const domains = [...domainCounts.entries()]
  .map(([label, count]) => ({ label, value: label.toLowerCase(), count }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<SiteSection id="projects" aria-label="Project catalog" data-projects-list>
  <SectionHeader
    eyebrow="Project catalog"
    title="Tools, platforms, and experiments made to be used."
    titleId="projects-title"
    description="Browse the complete Hyperoot catalog across developer tooling, automation, infrastructure, content systems, and applied AI."
  />

  <ProjectDomainFilter client:load domains={domains} projectCount={projects.length} />

  <div id="projects-grid" class="grid items-stretch bg-background-0 xl:grid-cols-2">
    {
      projects.map((project) => (
        <ProjectArchiveCard project={project} image={project.data.images?.[0] ?? placeholder} />
      ))
    }
  </div>
</SiteSection>
