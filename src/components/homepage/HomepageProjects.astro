---
import { getCollection } from "astro:content"
import CatalogControls from "@/components/project/CatalogControls.astro"
import ProjectRow from "@/components/project/ProjectRow.astro"
import { compareProjects } from "@/lib/project-catalog"

const projects = (await getCollection("projects")).filter((project) => !project.data.draft).sort(compareProjects)
const domains = [...new Set(projects.flatMap((project) => project.data.domains))].sort()
---

<section id="projects" class="project-catalog" data-project-catalog aria-labelledby="projects-title">
  <div class="catalog-section-heading">
    <div>
      <p class="eyebrow">Project index</p>
      <h2 id="projects-title">Browse the collection</h2>
    </div>
    <p class="catalog-count" data-catalog-count role="status" aria-live="polite" aria-atomic="true">
      {projects.length}
      projects
    </p>
  </div>
  <CatalogControls domains={domains} count={projects.length} />
  <ol id="project-list" class="project-list" data-project-list>
    {projects.map((project, index) => <ProjectRow project={project} index={index} />)}
  </ol>
  <div class="catalog-empty" data-catalog-empty hidden>
    <p>No projects found.</p>
    <span>Try a different search or clear the filters.</span>
    <button type="button" class="text-link" data-catalog-reset>Clear filters</button>
  </div>
  <p class="catalog-footnote">
    Active means a push in the last 30 days, including automated updates. Commit references show the latest commit on
    the default branch.
  </p>
</section>

<script>
import { setupCatalog } from "@/lib/catalog-controller"

setupCatalog()
document.addEventListener("astro:page-load", setupCatalog)
</script>
