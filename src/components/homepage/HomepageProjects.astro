---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import SectionHeader from "@/components/core/SectionHeader.astro";
import SiteSection from "@/components/core/SiteSection.astro";
import ProjectArchiveCard from "@/components/project/ProjectArchiveCard.astro";
import placeholder1 from "@/assets/placeholder1.png";
import placeholder2 from "@/assets/placeholder2.png";
import placeholder3 from "@/assets/placeholder3.png";
import placeholder4 from "@/assets/placeholder4.png";
import placeholder5 from "@/assets/placeholder5.png";

const projectImages = [placeholder1, placeholder2, placeholder3, placeholder4, placeholder5] as const;
const projects = await getCollection("projects").then((entries) =>
  entries
    .filter((entry) => !entry.data.draft && entry.data.featured)
    .sort((a, b) => {
      const featuredDelta = Number(b.data.featured) - Number(a.data.featured);
      return featuredDelta || (a.data.order ?? 999) - (b.data.order ?? 999);
    }),
);
const archivePageSize = 12;
const archiveTotalPages = Math.max(1, Math.ceil(projects.length / archivePageSize));
const domainCounts = new Map<string, number>();

for (const project of projects) {
  for (const domain of project.data.domains) {
    domainCounts.set(domain, (domainCounts.get(domain) ?? 0) + 1);
  }
}

const domains = [...domainCounts.entries()]
  .map(([label, count]) => ({ label, value: label.toLowerCase(), count }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<SiteSection id="projects" aria-label="Project catalog" data-projects-list>
  <SectionHeader
    eyebrow="Project catalog"
    title="Tools, platforms, and experiments made to be used."
    titleId="projects-title"
    description="Browse the complete Hyperoot catalog across developer tooling, automation, infrastructure, content systems, and applied AI."
  />

  <div class="site-section-heading px-5 py-8 md:px-10 md:py-10 lg:px-15" data-project-filter data-page-size={archivePageSize}>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="font-mono text-[0.6875rem] tracking-[0.14em] text-accent-1 uppercase">Pick a domain</p>
        <p class="mt-2 text-sm text-foreground-3" aria-live="polite">
          Showing <span data-visible-count>{Math.min(projects.length, archivePageSize)}</span> of
          <span data-project-count>{projects.length}</span> curated projects
        </p>
      </div>

      <div class="flex max-w-3xl flex-wrap gap-2" role="group" aria-label="Filter projects by domain">
        <button
          type="button"
          class="project-filter rounded-md border border-border bg-background-0 px-3 py-2 font-mono text-[0.6875rem] tracking-[0.08em] text-foreground-1 uppercase transition-colors hover:border-foreground-3 hover:text-foreground-0"
          data-domain-filter="all"
          aria-controls="projects-grid"
          aria-pressed="true"
        >
          All <span class="opacity-60">{projects.length}</span>
        </button>
        {
          domains.map(({ label, value, count }) => (
            <button
              type="button"
              class="project-filter rounded-md border border-border bg-background-0 px-3 py-2 font-mono text-[0.6875rem] tracking-[0.08em] text-foreground-1 uppercase transition-colors hover:border-foreground-3 hover:text-foreground-0"
              data-domain-filter={value}
              aria-controls="projects-grid"
              aria-pressed="false"
            >
              {label} <span class="opacity-60">{count}</span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div id="projects-grid" class="grid items-stretch gap-6 bg-background-0 p-5 md:grid-cols-2 md:p-8 xl:grid-cols-3 xl:gap-7 xl:p-12">
    {
      projects.map((project, index) => (
        <ProjectArchiveCard
          project={project}
          image={project.data.images?.[0] ?? projectImages[index % projectImages.length] ?? placeholder1}
          initiallyHidden={index >= archivePageSize}
        />
      ))
    }
  </div>

  <nav
    aria-label="Projects pagination"
    class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 px-5 py-7 md:px-10 lg:px-15"
    data-project-pagination
    hidden={archiveTotalPages <= 1}
  >
    <button
      type="button"
      class="group inline-flex w-fit items-center gap-2 text-sm text-foreground-1 transition-colors hover:text-accent-1 disabled:pointer-events-none disabled:text-foreground-3/45"
      data-page-previous
      disabled
    >
      <Icon name="arrow-left" class="size-4 transition-transform group-hover:-translate-x-1 motion-reduce:transition-none" />
      Previous
    </button>
    <span class="font-mono text-[0.6875rem] tracking-[0.14em] text-foreground-3 uppercase" data-page-status aria-live="polite">
      01 / {String(archiveTotalPages).padStart(2, "0")}
    </span>
    <button
      type="button"
      class="group inline-flex w-fit items-center gap-2 justify-self-end text-sm text-foreground-1 transition-colors hover:text-accent-1 disabled:pointer-events-none disabled:text-foreground-3/45"
      data-page-next
      disabled={archiveTotalPages <= 1}
    >
      Next
      <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" />
    </button>
  </nav>
</SiteSection>

<style>
  .project-filter[aria-pressed="true"] {
    border-color: var(--accent-1);
    background: var(--accent-1);
    color: var(--accent-contrast);
  }
</style>

<script>
  const setupProjectFilter = () => {
    const filterRoot = document.querySelector<HTMLElement>("[data-project-filter]");
    if (!filterRoot || filterRoot.dataset.filterReady === "true") return;

    const buttons = [...filterRoot.querySelectorAll<HTMLButtonElement>("[data-domain-filter]")];
    const cards = [...document.querySelectorAll<HTMLElement>("[data-project-archive-card]")];
    const grid = document.querySelector<HTMLElement>("#projects-grid");
    const count = filterRoot.querySelector<HTMLElement>("[data-project-count]");
    const visibleCount = filterRoot.querySelector<HTMLElement>("[data-visible-count]");
    const pagination = document.querySelector<HTMLElement>("[data-project-pagination]");
    const previous = pagination?.querySelector<HTMLButtonElement>("[data-page-previous]");
    const next = pagination?.querySelector<HTMLButtonElement>("[data-page-next]");
    const pageStatus = pagination?.querySelector<HTMLElement>("[data-page-status]");
    const pageSize = Number(filterRoot.dataset.pageSize ?? "12");
    const availableDomains = new Set(buttons.map((button) => button.dataset.domainFilter ?? "all"));
    const initialUrl = new URL(window.location.href);
    const domainFromUrl = initialUrl.searchParams.get("domain");
    const pageFromUrl = Number.parseInt(initialUrl.searchParams.get("project-page") ?? "1", 10);
    let selectedDomain = domainFromUrl && availableDomains.has(domainFromUrl) ? domainFromUrl : "all";
    let currentPage = Number.isFinite(pageFromUrl) && pageFromUrl > 0 ? pageFromUrl : 1;

    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-project-case-study-link]")) {
      link.addEventListener("click", () => {
        window.sessionStorage.setItem("projectArchiveReturnUrl", window.location.href);
      });
    }

    const persistView = () => {
      const url = new URL(window.location.href);
      if (selectedDomain === "all") url.searchParams.delete("domain");
      else url.searchParams.set("domain", selectedDomain);
      if (currentPage === 1) url.searchParams.delete("project-page");
      else url.searchParams.set("project-page", String(currentPage));
      window.history.replaceState(window.history.state, "", url);
    };

    const applyView = () => {
      const matchingCards = cards.filter((card) => {
        const domains = new Set((card.dataset.projectDomains ?? "").split("|").filter(Boolean));
        return selectedDomain === "all" || domains.has(selectedDomain);
      });
      const featured = matchingCards.find((card) => card.dataset.featuredCandidate === "true");
      const filteredCards = featured ? [featured, ...matchingCards.filter((card) => card !== featured)] : matchingCards;
      const totalPages = Math.max(1, Math.ceil(filteredCards.length / pageSize));
      currentPage = Math.min(currentPage, totalPages);
      const pageStart = (currentPage - 1) * pageSize;
      const pageEnd = pageStart + pageSize;

      if (grid) grid.append(...filteredCards, ...cards.filter((card) => !filteredCards.includes(card)));
      for (const card of cards) {
        const filteredIndex = filteredCards.indexOf(card);
        card.hidden = filteredIndex < pageStart || filteredIndex >= pageEnd;
      }
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.domainFilter === selectedDomain));
      }
      if (count) count.textContent = String(filteredCards.length);
      if (visibleCount) visibleCount.textContent = String(Math.min(pageSize, Math.max(0, filteredCards.length - pageStart)));
      if (pageStatus) pageStatus.textContent = `${String(currentPage).padStart(2, "0")} / ${String(totalPages).padStart(2, "0")}`;
      if (previous) previous.disabled = currentPage === 1;
      if (next) next.disabled = currentPage === totalPages;
      if (pagination) pagination.hidden = filteredCards.length <= pageSize;
      persistView();
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        selectedDomain = button.dataset.domainFilter ?? "all";
        currentPage = 1;
        applyView();
      });
    }
    previous?.addEventListener("click", () => {
      currentPage = Math.max(1, currentPage - 1);
      applyView();
    });
    next?.addEventListener("click", () => {
      currentPage += 1;
      applyView();
    });

    filterRoot.dataset.filterReady = "true";
    applyView();
  };

  setupProjectFilter();
  document.addEventListener("astro:page-load", setupProjectFilter);
</script>
